<div id="delete-popup" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4" role="dialog"
    aria-modal="true" aria-labelledby="delete-title" aria-hidden="true">
    <div class="relative w-full max-w-lg rounded-2xl bg-white p-8 text-center shadow-2xl sm:p-10">
        <button id="close-delete" type="button"
            class="absolute right-5 top-5 text-2xl text-slate-500 hover:text-slate-800" aria-label="Close">
            <i class="ri-close-line"></i>
        </button>
        <div
            class="mx-auto mb-5 flex h-20 w-20 items-center justify-center rounded-full bg-red-100 text-4xl text-red-600">
            <i class="ri-delete-bin-line"></i>
        </div>
        <h2 id="delete-title" class="mb-3 text-2xl font-bold text-slate-900">Delete this Hisaab?</h2>
        <p class="mb-8 text-lg leading-relaxed text-slate-600">
            Are you sure you want to delete this hisaab for
            <strong id="delete-date" class="text-slate-900"></strong> ? This action cannot be undone.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row">
            <button id="cancel-delete" type="button"
                class="w-full rounded-lg border-2 border-slate-200 px-4 py-3 font-semibold text-slate-800 hover:bg-slate-50">
                Cancel
            </button>
            <button type="button"
                class="w-full rounded-lg bg-red-600 px-4 py-3 font-semibold text-white hover:bg-red-700">
                Delete
            </button>
        </div>
    </div>
</div>