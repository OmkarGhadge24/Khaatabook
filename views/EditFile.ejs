<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Khaatabook</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css" rel="stylesheet" />
</head>

<body>
    <section class="navbar flex items-center justify-between px-25 py-4">
        <div class="flex items-center gap-2">
            <h6 class="text-xl text-blue-700 bg-blue-200 w-10 h-10 flex items-center justify-center rounded-full"><i
                    class="ri-book-open-line"></i></h6>
            <h1 class="text-2xl font-bold">Khaatabook</h1>
        </div>
        <div class="flex items-center gap-6">
            <a class="text-lg font-semibold hover:text-blue-500" href="/">Home</a>
            <a class="text-lg font-semibold hover:text-blue-500" href="/create">Create New Hisaab</a>
        </div>
    </section>
    <section>
        <div class="px-25 py-4 flex items-center gap-2 cursor-pointer" onclick="window.location.href='/'">
            <i class="ri-arrow-left-line"></i>
            <h3>Back to home</h3>
        </div>
        <div>
            <div>
                <h3 class="text-2xl font-bold px-25 pt-4">
                    Edit Hisaab
                </h3>
                <h6 class="text-lg text-gray-600 px-25">
                    Update the details of your hisaab.
                </h6>
            </div>
            <div class="px-25 py-2 box">
                <div class="mb-4">
                    <p class="block text-lg font-semibold mb-2 ">Date</p>
                    <p class="text-lg border border-gray-300 p-2 rounded-lg bg-gray-100">
                        <%= date %>
                    </p>
                </div>
                <div>
                    <p class="block text-lg font-semibold mb-2">Details</p>
                    <form class="space-y-4" action="/update/<%= filename %>" method="post">
                        <textarea name="data" class="w-full border border-gray-300 p-2 rounded-lg bg-gray-100"
                            rows="8"><%= data %></textarea>
                        <input type="submit" value="Update Hisaab"
                            class="bg-blue-400 text-white py-2 px-4 rounded-lg cursor-pointer hover:bg-blue-500">
                    </form>
                </div>
            </div>
        </div>
    </section>
</body>

</html>